extends layout.pug

block content
  .page-head
    h1.page-title= title
    p.page-desc 選擇要調整的通知項目。

  .nav-list
    each row in results
      a.nav-card(href=row.url)
        span.nav-card-icon
          +icon(row.icon)
        span.nav-card-text
          span.nav-card-title= row.title
          span.nav-card-desc= row.desc
        span.nav-card-chevron
          +icon('chevron')
