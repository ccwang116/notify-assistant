extends layout.pug

block content
  .page-head
    h1.page-title= title
    p.page-desc 設定要查詢的地區，每天固定時間推送天氣預報到 LINE。

  form.card(method="post" action=form_action)
    .card-head
      div
        h2.card-title 地區設定
        p.card-desc 資料來源為中央氣象署開放資料。
      a.link-subtle(href="https://opendata.cwa.gov.tw/opendatadoc/Opendata_City.pdf" target="_blank" rel="noopener")
        | 地區代碼文件
        +icon('external')
    .card-body
      if canEdit
        .field-row
          .field
            label.field-label(for="locationId") 縣市資料集 ID
            input#locationId.input(type="text" name="locationId" value=locationId autocomplete="off" spellcheck="false" required)
            p.field-hint 例如 F-D0047-071
          .field
            label.field-label(for="currentLocation") 行政區
            input#currentLocation.input(type="text" name="currentLocation" value=currentLocation autocomplete="off" required)
            p.field-hint 例如 中和區
      else
        dl.summary
          .summary-row
            dt 縣市資料集 ID
            dd= locationId
          .summary-row
            dt 行政區
            dd= currentLocation
        include _edit-notice
    .card-foot
      a.btn.btn-secondary(href=`/weather/${locationId}/${currentLocation}`)
        +icon('send')
        | 立即通知
      if canEdit
        button.btn.btn-primary(type="submit") 儲存設定
